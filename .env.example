# ============================================
# AI 私厨 v2.0 - 环境变量示例（提交进 Git）
# ============================================
# 复制为 .env 后填入真实值；.env 必须加入 .gitignore

# ===== 基础 =====
APP_ENV=dev
DEBUG=true
HOST=0.0.0.0
PORT=8002

# ===== 安全（生产必改；用 openssl rand -hex 32 生成）=====
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ===== DashScope（阿里云百炼）=====
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen3-omni-flash
EMBEDDING_MODEL=text-embedding-v3

# ===== Tavily =====
TAVILY_API_KEY=

# ===== 阿里云 OSS =====
# ⚠️ 键名是 ALIBABA_CLOUD_*，与 SDK 默认凭证提供器一致
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
OSS_BUCKET=aiprogram
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com

# ===== 数据库 =====
DATABASE_URL=sqlite:///./db/personal_chief.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_USER_PER_MINUTE=20

# ===== LangSmith（可选；生产环境注意数据隐私）=====
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ai-sichu-v2

# ===== CORS =====
# 列表格式：["url1","url2"]；本地开发保留 8002 与 "null"
CORS_ORIGINS=["http://127.0.0.1:8002","http://localhost:8002","null"]

# ===== 依赖提示（pyproject.toml 中应包含）=====
# oss2>=2.19.1           # app_my/api/oss.py 使用的是旧 SDK oss2
# pydantic-settings>=2.0 # app_my/core/config.py 用到

# ===== 数据库（阶段 2：PGVector 向量库）=====
# 格式：postgresql+psycopg2://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+psycopg2://ai_sichu:ai_sichu@localhost:5432/ai_sichu


# 阶段 7：可观测栈
PROMETHEUS_METRICS_PATH=/metrics
LOKI_URL=http://localhost:3100
PROMETHEUS_MULTIPROC_DIR=